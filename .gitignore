target/
src-tauri/target/
src-tauri/gen/
node_modules/
dist/

.env
.env.*
!.env.example

# Updater & Android signing keys must never be committed
*.key
*.key.pub
*.jks
*.keystore
*.p12
*.pem

# Promo code plaintext must never be committed
supabase/CODES.txt
supabase/CODES.sql

# Generated from src/assets/badges/badges.json — see make_badges_sql.mjs
supabase/BADGES.sql
supabase/.temp/

# Bundled ffmpeg: ~110 MB per platform, fetched by scripts/fetch-ffmpeg.mjs
# and verified against the publisher's own checksum. The licence text is
# committed; the binaries are not, whatever the host triple is.
src-tauri/ffmpeg/ffmpeg-*
src-tauri/ffmpeg/.sha256

# Generated by `tauri icon` for platforms that are not packaged yet.
src-tauri/icons/android/
src-tauri/icons/ios/

*.log
.DS_Store
Thumbs.db

# Editor & IDE files
.idea/
.vscode/
*.kate-swp
*.swp
*.swo
*~

# Local scratch, not part of the project: test downloads and an old archive
# of the source. Nothing in the build reads either.
.tmp-dl/
src.rar

# Tauri only auto-merges `tauri.local.conf.json` (with the dots), so this
# `tauri.local.json` is inert — kept on disk, kept out of the repository.
src-tauri/tauri.local.json

# Scratch files, agent progress, mockups & local tool config
AGENT_PROGRESS.md
Pasted image*.png
smoke-test*.png
tests/verify-*.mjs
.mcp.json
bun.lock
bun.lockb

# Python bytecode
__pycache__/
*.pyc

# Executables & Installers
*.exe
# AppImage bundles are ~175 MB and belong in release assets, not in git history
*.AppImage
*.apk
*.aab
*.ipa
*.dmg
*.deb
*.rpm

# Local agent skills stay out of git, except the project skills (meowave-*)
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/meowave-*/


# Installers are published as GitHub Release assets, not committed
installer/

# AI assistants, neural IDE configs, instructions & prompts
.gemini/
.antigravity/
.freebuff/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.codeium/
.claude/
.copilot/
.continue/
.aider*
.ai/
*.prompt
*.prompts
*ai_instructions*
*ai-instructions*
copilot-instructions.md
.github/copilot-instructions.md
ai-rules/
*.chat
.trae/
.cline/
.roo/
.devin/
*.prompt.md
*.prompt.txt
