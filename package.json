{
  "name": "meowave",
  "version": "3.4.0",
  "private": true,
  "description": "Meowave desktop player: the frontend build (Vite + TypeScript), badge catalog, Supabase schema and seeding.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "node scripts/web.mjs build --install && tauri dev",
    "web": "vite",
    "web:build": "node scripts/web.mjs build",
    "web:watch": "node scripts/web.mjs watch",
    "web:preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "android:dev": "node scripts/web.mjs build --install && bash -c 'source scripts/setup-android-env.sh && tauri android dev'",
    "android:emulator": "./scripts/run-emulator.sh",
    "android:run": "./scripts/smart-install.sh",
    "android:build": "bash scripts/android-build.sh",
    "android:rekey": "bash scripts/android-rekey.sh",
    "android:build:debug": "bash -c 'source scripts/setup-android-env.sh && tauri android build --apk --debug'",
    "android:build:x86": "bash -c 'source scripts/setup-android-env.sh && tauri android build --apk --target x86_64 --debug'",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build": "node scripts/web.mjs deps && node scripts/fetch-ffmpeg.mjs && tauri build",
    "build:appimage": "bash scripts/build-appimage.sh",
    "install:linux": "bash install.sh",
    "check": "node scripts/web.mjs build && cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test",
    "check:js": "node --check src/app.js && tsc -p tsconfig.json",
    "test:e2e": "node tests/run-e2e.mjs",
    "badges": "node src/assets/badges/_gen.mjs",
    "badges:sql": "node supabase/make_badges_sql.mjs",
    "badges:seed": "node supabase/seed_badges.mjs",
    "codes": "node supabase/make_codes.mjs",
    "schema": "node supabase/build_sql.mjs",
    "sync:docs": "node scripts/sync-docs-badges.mjs",
    "promo": "node scripts/promo-shots.mjs",
    "find-cyrillic": "node scripts/find-cyrillic.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
