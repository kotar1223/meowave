{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowave",
  "version": "3.3.0",
  "identifier": "app.meowave.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": { "script": "node scripts/web.mjs watch", "wait": false },
    "beforeBuildCommand": "node scripts/web.mjs build",
    "additionalWatchFolders": ["../dist"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Meowave",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 520,
        "maximized": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0d14",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:* https: data: blob:; media-src 'self' http://127.0.0.1:* https: blob: data:; connect-src 'self' http://127.0.0.1:* https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.0.2 https://huggingface.co https://*.hf.co; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.0.2; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "licenseFile": "ffmpeg/LICENSE.txt",
    "externalBin": ["ffmpeg/ffmpeg"],
    "resources": {
      "ffmpeg/LICENSE.txt": "FFMPEG-LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kotar1223/meowave/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNDUyMDlCRDdCMUJFNjgKUldSb3ZySFhteUJGNHJjMk54b2FPZUlUczI5ZUNybFlIZ1lkSEQrY3BlMDVZNTlULyt6Y1lyUWgK"
    }
  }
}
