# Supabase: Project Settings -> API.
#
# Both are optional. The values compiled into the binary (src-tauri/src/config.rs)
# point at the production project, so a plain clone runs without a .env; set these
# to point the app at your own project instead.
#
# The anon/publishable key is safe to commit: access is bounded by RLS policies,
# not by the key being secret. The service_role key is NOT — it bypasses RLS and
# belongs only in the shell where you run supabase/seed_badges.mjs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Newer projects issue a "publishable" key instead; either name is read.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Spotify: Developer Dashboard -> your app -> Client ID.
# Without it the Spotify commands report "not configured" instead of failing
# inside the token exchange. The redirect URI registered there must be exactly
# http://localhost:8080/callback
SPOTIFY_CLIENT_ID=

# Yandex Music OAuth app (optional). With a client id the sign-in flow opens
# the real oauth.yandex.ru/authorize page (response_type=token, implicit
# grant); without one it opens music.yandex.ru and the local helper page
# takes the token from either source.
YM_CLIENT_ID=
